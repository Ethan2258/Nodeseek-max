{
	"name": "nodeseek-max",
	"version": "1.9.0",
	"private": true,
	"description": "NodeSeek 全能增强用户脚本：融合 NodeSeek++、外链跳转、黑名单通知屏蔽、侧栏热榜与现代化主题",
	"license": "GPL-3.0-only",
	"homepage": "https://github.com/Ethan2258/Nodeseek-max#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ethan2258/Nodeseek-max.git"
	},
	"scripts": {
		"build": "npm run sb && npm run meta",
		"meta": "node scripts/build-meta.mjs",
		"check": "node scripts/check-repo.mjs && node --check nodeseek-max.user.js && node scripts/build-sb.mjs --check && node scripts/build-meta.mjs --check",
		"sb": "node scripts/build-sb.mjs",
		"test": "node --test --test-concurrency=1 tests/smoke.test.cjs tests/settings.test.cjs tests/mobile.test.cjs tests/userscripts.test.cjs tests/lottery.test.cjs tests/pagination.test.cjs tests/polish.test.cjs tests/comment-pin.test.cjs tests/details.test.cjs tests/first-frame.test.cjs tests/ui-polish.test.cjs tests/activity.test.cjs",
		"test:smoke": "node --test --test-concurrency=1 tests/smoke.test.cjs",
		"test:settings": "node --test --test-concurrency=1 tests/settings.test.cjs",
		"test:mobile": "node --test --test-concurrency=1 tests/mobile.test.cjs",
		"test:userscripts": "node --test --test-concurrency=1 tests/userscripts.test.cjs",
		"test:lottery": "node --test --test-concurrency=1 tests/lottery.test.cjs",
		"screenshots": "node tests/ui-audit.cjs",
		"performance": "node tests/performance.cjs",
		"upstream": "node scripts/upstream.mjs",
		"minify": "node scripts/minify.mjs",
		"test:pagination": "node --test --test-concurrency=1 tests/pagination.test.cjs",
		"test:polish": "node --test --test-concurrency=1 tests/polish.test.cjs",
		"test:pin": "node --test --test-concurrency=1 tests/comment-pin.test.cjs",
		"test:details": "node --test --test-concurrency=1 tests/details.test.cjs",
		"test:first-frame": "node --test --test-concurrency=1 tests/first-frame.test.cjs",
		"test:ui": "node --test --test-concurrency=1 tests/ui-polish.test.cjs",
		"test:activity": "node --test --test-concurrency=1 tests/activity.test.cjs"
	},
	"devDependencies": {
		"playwright": "1.64.1",
		"postcss": "8.5.30",
		"postcss-selector-parser": "7.1.6",
		"terser": "5.51.2"
	},
	"engines": {
		"node": ">=22"
	}
}
